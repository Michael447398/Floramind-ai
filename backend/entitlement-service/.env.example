PAYSTACK_ANNUAL_AMOUNT_SMALLEST_UNIT=0
PAYSTACK_LIFETIME_AMOUNT_SMALLEST_UNIT=0

# Google Play Developer API Verification (Android In-App Billing & RTDN)
