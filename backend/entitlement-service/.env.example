PORT=8080

# Shared Product Identifiers (match Google Play Console & Paystack config)
FREE_IDENTIFICATION_LIMIT=10
PRODUCT_ID_MONTHLY=floramind_premium_monthly
PRODUCT_ID_ANNUAL=floramind_premium_annual
PRODUCT_ID_LIFETIME=floramind_lifetime_premium

# Paystack Configuration (Website Checkout & Webhooks — NEVER deploy secret keys in Android/frontend)
PAYSTACK_SECRET_KEY=sk_live_or_test_configure_in_secret_manager
PAYSTACK_WEBHOOK_SECRET=whsec_configure_in_secret_manager
PAYSTACK_CURRENCY=NGN
PAYSTACK_CALLBACK_URL=https://your-web-domain.example/billing/callback
# Set plan codes and smallest-currency-unit amounts (e.g. kobo/cents) in deployment secrets:
PAYSTACK_MONTHLY_PLAN_CODE=
PAYSTACK_ANNUAL_PLAN_CODE=
